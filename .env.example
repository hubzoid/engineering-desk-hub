# Copy to .env (never commit it).
# The model: a signed-in Claude Code (claude-local) or Codex (codex-local) on
# this machine. No API key needed. A provider key works too (see Hubzoid's docs).
MODEL=claude-local
# Required: lets `hubzoid run` run Engineering Desk's schedules (sweeps, profiles,
# security watch, digests). Without it nothing runs on its own.
HUBZOID_SCHEDULES=1
# GITHUB_TOKEN goes in .env, never in .env.example. Add it without it showing
# on screen or in your shell history (SETUP.md, step 2):
#   read -rs GH && printf 'GITHUB_TOKEN=%s\n' "$GH" >> .env && unset GH
